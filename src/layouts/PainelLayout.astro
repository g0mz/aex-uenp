---
import '../styles/global.css';

interface Props { title: string }
const { title } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} | Painel</title>
  </head>
  <body>
    <a href="#conteudo" class="fixed left-4 top-4 z-[100] -translate-y-24 bg-safety px-4 py-3 font-bold text-ink focus:translate-y-0">Ir para o conteúdo</a>
    <header class="bg-ink text-white">
      <div class="container-site flex min-h-16 items-center justify-between gap-4">
        <a href="/painel" class="font-black uppercase tracking-wider">Painel da oficina</a>
        <form method="post" action="/painel/sair">
          <button type="submit" class="button-secondary text-white">Sair</button>
        </form>
      </div>
      <div class="hazard-stripe h-1.5" aria-hidden="true"></div>
    </header>
    <main id="conteudo" class="container-site py-8"><slot /></main>
  </body>
</html>
