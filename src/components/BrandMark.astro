---
interface Props {
  light?: boolean;
  compact?: boolean;
}

const { light = false, compact = false } = Astro.props;
---

<a href="#inicio" class="group inline-flex items-center gap-3" aria-label="Mecânica Gaúcho Diesel — início">
  <span class="relative grid size-14 shrink-0 place-items-center border border-white bg-ink p-0.5 shadow-[2px_2px_0_rgba(0,0,0,.25)]" aria-hidden="true">
    <img src="/images/brand/logo-oficina-160.webp" alt="" width="160" height="160" class="size-full object-contain" />
  </span>
  {!compact && (
    <strong class:list={[
      "font-display whitespace-nowrap text-[0.72rem] font-black uppercase leading-none tracking-[-0.025em] min-[380px]:text-[0.9rem] sm:text-[1.15rem]",
      light ? "text-white" : "text-ink",
    ]}>
      Mecânica Gaúcho Diesel
    </strong>
  )}
</a>
