---
// UC07 Listar solicitações: da mais recente para a mais antiga, com filtros por situação e tipo.
import PainelLayout from '../../layouts/PainelLayout.astro';
import SeloSituacao from '../../components/SeloSituacao.astro';
import { listar } from '../../lib/repositorio';
import { SITUACOES, TIPOS } from '../../lib/solicitacao';

export const prerender = false;

const situacao = Astro.url.searchParams.get('situacao') ?? '';
const tipo = Astro.url.searchParams.get('tipo') ?? '';
const solicitacoes = await listar({ situacao, tipo });
const data = (iso: string) => new Date(iso).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', dateStyle: 'short', timeStyle: 'short' });
const th = 'p-3 text-xs font-black uppercase tracking-[0.16em] text-steel';
---

<PainelLayout title="Solicitações">
  <p class="eyebrow text-steel">Painel</p>
  <h1 class="display-type mt-5 text-3xl leading-[1.05] sm:text-4xl">Solicitações</h1>

  <form method="get" class="mt-6 flex flex-wrap items-end gap-4 border border-ink/20 bg-white p-5 shadow-[8px_8px_0_#051326]">
    <label class="campo">Situação
      <select name="situacao">
        <option value="">Todas</option>
        {Object.entries(SITUACOES).map(([v, r]) => <option value={v} selected={situacao === v}>{r}</option>)}
      </select>
    </label>
    <label class="campo">Tipo
      <select name="tipo">
        <option value="">Todos</option>
        {Object.entries(TIPOS).map(([v, r]) => <option value={v} selected={tipo === v}>{r}</option>)}
      </select>
    </label>
    <button type="submit" class="button-primary">Filtrar</button>
  </form>

  {solicitacoes.length === 0 ? (
    <p class="mt-8 text-base text-steel">Nenhuma solicitação encontrada.</p>
  ) : (
    <div class="mt-8 overflow-x-auto border border-ink/20 bg-white shadow-[8px_8px_0_#051326]" role="region" aria-label="Solicitações" tabindex="0">
      <table class="w-full border-collapse text-left text-base">
        <thead><tr class="border-b-2 border-ink">
          <th scope="col" class={th}>Protocolo</th><th scope="col" class={th}>Data</th><th scope="col" class={th}>Nome</th><th scope="col" class={th}>Tipo</th><th scope="col" class={th}>Caminhão</th><th scope="col" class={th}>Situação</th>
        </tr></thead>
        <tbody>
          {solicitacoes.map((s) => (
            <tr class="border-b border-ink/10 hover:bg-paper">
              <td class="p-3"><a href={`/painel/${s.id}`} class="whitespace-nowrap font-black underline">{s.protocolo ?? `Nº ${s.id}`}</a></td>
              <td class="whitespace-nowrap p-3">{data(s.criada_em)}</td>
              <td class="p-3">{s.nome}</td>
              <td class="p-3">{TIPOS[s.tipo as keyof typeof TIPOS]}</td>
              <td class="p-3">{[s.marca, s.modelo, s.placa].filter(Boolean).join(' ') || 'Não informado'}</td>
              <td class="p-3"><SeloSituacao situacao={s.situacao} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</PainelLayout>
