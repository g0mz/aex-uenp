---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { whatsappUrl } from '../../data/company';
import { env } from 'cloudflare:workers';

export const prerender = false;

const protocolo = Astro.url.searchParams.get('p') ?? '';
if (!/^GD-\d{4}-\d{6}$/.test(protocolo)) return Astro.redirect('/solicitar');
const codigo = Astro.url.searchParams.get('t') ?? '';
const telegram = /^[0-9a-f]{32}$/.test(codigo) && /^\w+$/.test(env.TELEGRAM_BOT_USUARIO ?? '')
  ? `https://t.me/${env.TELEGRAM_BOT_USUARIO}?start=${codigo}` : '';
const socorro = Astro.url.searchParams.get('tipo') === 'socorro';
---

<BaseLayout title="Solicitação enviada | Mecânica Gaúcho Diesel" description="Confirmação da solicitação de atendimento." noindex>
  <Header />
  <main id="conteudo" class="section-pad">
    <div class="container-site max-w-3xl">
      <p class="eyebrow text-steel">Atendimento</p>
      <h1 class="display-type mt-5 text-3xl leading-[1.05] sm:text-4xl">Solicitação enviada</h1>
      <div class="mt-8 bg-ink p-7 text-white shadow-[8px_8px_0_#051326] sm:p-10">
        <p class="text-xs font-black uppercase tracking-[0.16em] text-white/70">Número do protocolo</p>
        <p class="display-type mt-2 text-3xl text-safety sm:text-4xl">{protocolo}</p>
      </div>
      <p class="mt-8 text-base leading-7 text-steel sm:text-lg">A oficina vai analisar o pedido e entrar em contato pelo telefone informado. O orçamento é feito após o diagnóstico na oficina.</p>
      {socorro && (
        <p class="mt-4 text-base leading-7 text-steel sm:text-lg">O socorro na rodovia depende do alcance e da disponibilidade do mecânico. Em caso urgente, chame a oficina no <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-ink underline">WhatsApp</a>.</p>
      )}
      {telegram && (
        <div class="mt-8">
          <a href={telegram} target="_blank" rel="noopener noreferrer" class="button-primary">Receber atualizações no Telegram</a>
          <p class="mt-3 text-sm leading-6 text-steel">Opcional. Ao tocar em "Iniciar" no bot, você recebe uma mensagem a cada mudança de situação do pedido.</p>
        </div>
      )}
      <div class="mt-8 flex flex-wrap items-center gap-6">
        <a href={`/acompanhar?p=${protocolo}`} class="button-secondary">Acompanhar solicitação</a>
        <a href="/" class="font-bold underline">Voltar ao site</a>
      </div>
    </div>
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>
