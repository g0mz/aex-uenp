---
// UC14 Acompanhar solicitação: consulta pelo protocolo e telefone, sem expor outros dados pessoais.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import SeloSituacao from '../components/SeloSituacao.astro';
import { acompanhar } from '../lib/repositorio';

export const prerender = false;

let protocolo = Astro.url.searchParams.get('p') ?? '';

let resultado: Awaited<ReturnType<typeof acompanhar>> = null;
let consultou = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  protocolo = String(form.get('protocolo') ?? '').trim().toUpperCase();
  const telefone = String(form.get('telefone') ?? '').trim();
  consultou = true;
  if (/^GD-\d{4}-\d{6}$/.test(protocolo) && telefone.length > 0 && telefone.length <= 20) {
    try { resultado = await acompanhar(protocolo, telefone); } catch { resultado = null; }
  }
}
const dataHora = (iso: string) => new Date(iso).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });
---

<BaseLayout title="Acompanhar solicitação | Mecânica Gaúcho Diesel" description="Consulte a situação da sua solicitação de atendimento." noindex>
  <Header />
  <main id="conteudo" class="section-pad">
    <div class="container-site max-w-3xl">
      <p class="eyebrow text-steel">Atendimento</p>
      <h1 class="display-type mt-5 text-3xl leading-[1.05] sm:text-4xl">Acompanhar solicitação</h1>
      <p class="mt-5 text-base leading-7 text-steel sm:text-lg">Informe o número do protocolo e o telefone cadastrado no pedido.</p>

      <div class="mt-10 border border-ink/20 bg-white p-7 shadow-[8px_8px_0_#051326] sm:p-10">
        <form method="post" class="grid gap-5">
          <label class="campo">Protocolo <input name="protocolo" value={protocolo} maxlength="14" placeholder="GD-2026-000001" autocapitalize="characters" required /></label>
          <label class="campo">Telefone <input name="telefone" maxlength="20" type="tel" autocomplete="tel" required /></label>
          <button type="submit" class="button-primary justify-self-start">Consultar</button>
        </form>
      </div>

      {consultou && !resultado && <p class="erro mt-8" role="alert">Solicitação não encontrada.</p>}
      {resultado && (
        <div class="mt-8 bg-ink p-7 text-white shadow-[8px_8px_0_#051326] sm:p-10" role="status">
          <p class="text-xs font-black uppercase tracking-[0.16em] text-white/70">Protocolo</p>
          <p class="display-type mt-2 text-3xl text-safety sm:text-4xl">{resultado.protocolo}</p>
          <p class="mt-6"><SeloSituacao situacao={resultado.situacao} /></p>
          <p class="mt-4 text-sm text-white/80">Última atualização: {dataHora(resultado.atualizada_em)}</p>
          {resultado.situacao === 'recusada' && resultado.motivo_recusa && (
            <p class="mt-4 whitespace-pre-line break-words font-bold">Motivo da recusa: {resultado.motivo_recusa}</p>
          )}
        </div>
      )}
    </div>
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>
