---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';

const title = 'Mecânica Gaúcho Diesel | Ourinhos e Região';
const description = 'Oficina especializada em caminhões em Ourinhos e região. Manutenção preventiva, mecânica geral diesel e socorro para caminhoneiros, empresas e frotas.';
---

<BaseLayout {title} {description}>
  <Header />
  <main id="conteudo">
    <Hero />
  </main>
  <Footer />
</BaseLayout>
