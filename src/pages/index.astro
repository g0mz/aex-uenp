---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AboutSection from '../components/AboutSection.astro';
import BrandsSection from '../components/BrandsSection.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import ClientsSection from '../components/ClientsSection.astro';
import LocationSection from '../components/LocationSection.astro';
import ContactSection from '../components/ContactSection.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';

const title = 'Mecânica Gaúcho Diesel | Ourinhos e Região';
const description = 'Oficina especializada em caminhões em Ourinhos e região. Manutenção preventiva, mecânica geral diesel e socorro para caminhoneiros, empresas e frotas.';
const configuredSite = Astro.site?.toString().replace(/\/$/, '');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: company.name,
  description,
  ...(configuredSite ? { url: configuredSite } : {}),
  ...(configuredSite ? { logo: `${configuredSite}/images/brand/logo-oficina.png` } : {}),
  telephone: `+${company.phoneDigits}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rod. Raposo Tavares, KM 377 + 700 m - Parque Valeriano Marcante',
    addressLocality: company.city,
    addressRegion: company.state,
    postalCode: '19915-022',
    addressCountry: 'BR',
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '18:00',
  }],
};
---

<BaseLayout {title} {description} {structuredData}>
  <Header />
  <main id="conteudo">
    <Hero />
    <ServicesSection />
    <PortfolioSection />
    <AboutSection />
    <ClientsSection />
    <BrandsSection />
    <LocationSection />
    <ContactSection />
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>
